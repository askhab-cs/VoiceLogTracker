{
  "expo": {
    "name": "Voice Log",
    "slug": "VoiceLogTracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "voicelogtracker",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.askhabchik.voicelog",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.askhabchik.voicelog",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F2F2F5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Voice Log uses the microphone to record your spoken activity logs."
        }
      ],
      "expo-localization",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
